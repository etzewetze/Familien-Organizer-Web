Options -Indexes -MultiViews
RewriteEngine On

# Wenn das Repository selbst als DocumentRoot gesetzt wurde, Inhalte nur aus
# public/ ausliefern. Datenbankkonfiguration, Bilder und Git-Metadaten bleiben zu.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteRule ^(?:config\.php|data(?:/|$)|\.git(?:/|$)|\.env(?:$|/)) - [F,L,NC]
RewriteRule ^public(?:/|$) - [L]
RewriteRule ^(.*)$ public/$1 [L]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Cache-Control "no-store, no-cache, must-revalidate, private"
</IfModule>
